# Copy to .env.local for a local production build, or set these on the host.
# Nothing here is a secret: the site has none.

# The public origin of the deployed site, without a trailing slash. It is used
# for canonical addresses, the sitemap, robots.txt and the share images.
# On Vercel it may be left unset: the production host is used.
SITE_URL=https://example.com

# The live sandbox runs one workflow on the server against a database made for
# the request. It needs Node 22.5 or later. Uncomment to switch it off; every
# demo then runs as a simulation in the browser and says so.
# SANDBOX_DISABLED=1

# Where the sandbox keeps its ledger of runs. The default is .data/ beside the
# app, then the system's temporary directory, then memory.
# SANDBOX_DATA_DIR=/var/data/portfolio
